{"durationSeconds": 63.78, "scenes": [{"kind": "world", "start": 0.0, "end": 5.6, "camera": [{"t": 0, "lon": 25, "lat": 18, "zoom": 1.55}, {"t": 5.6, "lon": 45, "lat": 20, "zoom": 1.9}]}, {"kind": "wallet", "start": 5.6, "end": 10.2, "revealAt": 9.0}, {"kind": "profit", "start": 10.2, "end": 14.6, "source": "VISA FISCAL YEAR 2025 \u00b7 $20.06B NET INCOME ON $40.0B REVENUE"}, {"kind": "bank", "start": 14.6, "end": 22.0, "steps": [14.8, 16.7, 19.6]}, {"kind": "world", "start": 22.0, "end": 32.6, "camera": [{"t": 22, "lon": 30, "lat": 22, "zoom": 2.6}, {"t": 27, "lon": 50, "lat": 20, "zoom": 2.1}, {"t": 32.6, "lon": 55.3, "lat": 25.2, "zoom": 3.4}], "busy": [22.0, 27.5], "fees": [26.5, 26.92, 27.34, 27.76, 28.18, 28.6, 29.02, 29.44, 29.86, 30.28, 30.7, 31.12, 31.54, 31.96]}, {"kind": "video", "start": 32.6, "end": 45.0, "src": "rk/dubai.mp4"}, {"kind": "image", "start": 40.1, "end": 41.75, "src": "rk/tower_clouds.jpg", "zoom": [1.0, 1.08], "title": {"kicker": "INTRODUCING", "lines": ["Christian A. Rockefeller", "BUSINESS TOWER"]}}, {"kind": "image", "start": 44.85, "end": 47.05, "src": "rk/tower_night.jpg", "zoom": [1.05, 1.16], "pan": [[0, 0.02], [0, -0.02]]}, {"kind": "image", "start": 47.05, "end": 51.25, "src": "rk/nyc_legacy.jpg", "zoom": [1.0, 1.12]}, {"kind": "image", "start": 51.25, "end": 53.0, "src": "rk/tower_clouds2.jpg", "zoom": [1.12, 1.0]}, {"kind": "image", "start": 53.0, "end": 54.7, "src": "rk/boardroom.jpg", "zoom": [1.0, 1.1]}, {"kind": "image", "start": 54.7, "end": 56.7, "src": "rk/tower_top_sunset.jpg", "zoom": [1.0, 1.12], "pan": [[0, -0.02], [0, 0.02]]}, {"kind": "image", "start": 56.7, "end": 59.1, "src": "rk/rooftop_pool.jpg", "zoom": [1.0, 1.1]}, {"kind": "image", "start": 59.1, "end": 64.28, "src": "rk/lobby.jpg", "zoom": [1.0, 1.08]}], "captions": [{"start": 0.0, "end": 1.75, "text": "Do you know the *most *profitable company in the world?"}, {"start": 1.75, "end": 3.45, "text": "Not Apple, not Nvidia,"}, {"start": 3.45, "end": 5.4, "text": "not even an *oil company."}, {"start": 5.45, "end": 7.95, "text": "This company is in your *pocket right now."}, {"start": 7.95, "end": 9.0, "text": "Open your wallet\u2026"}, {"start": 9.0, "end": 10.35, "text": "*Visa, or Mastercard!"}, {"start": 10.35, "end": 13.45, "text": "Visa makes *50% net profit on every dollar it makes."}, {"start": 13.55, "end": 14.65, "text": "Here's the *interesting part:"}, {"start": 14.65, "end": 16.6, "text": "Visa doesn't give you your debit or credit card. The *bank does."}, {"start": 16.6, "end": 19.5, "text": "Visa doesn't give you a loan. The *bank does."}, {"start": 19.55, "end": 21.95, "text": "No risk for Visa. *Easy *profits."}, {"start": 22.0, "end": 23.2, "text": "They're like a *bridge."}, {"start": 23.2, "end": 26.3, "text": "Wherever money moves in the world, it crosses *this *bridge."}, {"start": 26.35, "end": 28.7, "text": "Every time you swipe your card, a small *fee."}, {"start": 28.75, "end": 32.5, "text": "Every day, silently, *billions of transactions around the world, and they make profits from it."}, {"start": 32.55, "end": 34.9, "text": "Dubai real estate has the same kind of *silent *opportunity:"}, {"start": 34.9, "end": 36.2, "text": "*commercial real estate."}, {"start": 36.2, "end": 40.1, "text": "Invest 13 crores and earn up to *1.3 *crore in rent, in this project:"}, {"start": 40.1, "end": 41.85, "text": "*Christian *A. *Rockefeller Business Tower."}, {"start": 41.85, "end": 44.75, "text": "400 metres, *87 *floors, on Sheikh Zayed Road."}, {"start": 44.75, "end": 46.95, "text": "This is Dubai's *tallest *commercial tower."}, {"start": 46.95, "end": 51.3, "text": "The world's first billionaire, the Rockefeller family's *sixth *generation, Christian Rockefeller is the brand."}, {"start": 51.5, "end": 52.95, "text": "Easy *50-50 payment plan."}, {"start": 52.95, "end": 54.65, "text": "Offices start from *13 *crores."}, {"start": 54.65, "end": 56.8, "text": "If you want silent, massive profits like *Visa,"}, {"start": 56.8, "end": 58.8, "text": "this project should be on your *watch *list."}, {"start": 58.95, "end": 61.45, "text": "For more information, comment *ROCKEFELLER"}, {"start": 61.45, "end": 62.85, "text": "or contact the number on screen."}, {"start": 62.85, "end": 63.68, "text": "*I'll get in touch."}], "headlines": [{"start": 0.15, "end": 1.65, "lines": ["WHICH", "*company?"], "kicker": "QUICK QUESTION", "y": 250, "align": "left"}, {"start": 22.0, "end": 26.2, "lines": ["A BRIDGE", "*for money"], "kicker": "THE NETWORK", "y": 250, "align": "left"}, {"start": 28.8, "end": 32.5, "lines": ["BILLIONS OF", "*transactions"], "kicker": "EVERY DAY", "y": 250, "align": "left"}, {"start": 32.6, "end": 36.2, "lines": ["COMMERCIAL", "*property"], "kicker": "DUBAI'S SILENT OPPORTUNITY", "y": 250, "align": "left"}], "cards": [{"type": "list", "start": 42.0, "end": 44.75, "title": "THE TOWER", "color": "#FFC940", "y": 560, "items": [{"at": 42.9, "text": "87 floors"}, {"at": 44.0, "text": "Sheikh Zayed Road"}]}, {"type": "list", "start": 45.0, "end": 46.95, "title": "DEVELOPER'S PLAN", "color": "#FFC940", "y": 560, "items": [{"at": 45.4, "text": "Dubai's tallest commercial tower"}]}, {"type": "count", "start": 48.6, "end": 51.2, "value": 6, "suffix": "th", "unit": "generation Rockefeller", "note": "CHRISTIAN A. ROCKEFELLER \u00b7 BRAND PARTNER", "color": "#FFC940", "y": 560}, {"type": "list", "start": 51.5, "end": 52.95, "title": "PAYMENT PLAN", "color": "#FFC940", "y": 560, "items": [{"at": 51.7, "text": "50% during construction"}, {"at": 52.2, "text": "50% on handover"}]}, {"type": "list", "start": 53.1, "end": 54.65, "title": "GRADE A OFFICES", "color": "#FFC940", "y": 560, "items": [{"at": 53.3, "text": "From 1,077 sq ft"}]}], "speaker": {"video": "rk/speaker.mp4", "hide": [[0, 5.9]]}, "speakerIntro": {"video": "rk/speaker_intro.mp4", "end": 5.45}, "hookLogos": {"person": "rk/person.webm", "items": [{"src": "rk/apple.svg", "at": 1.8, "x": 300, "y": 720, "width": 2